#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Раздел = ОписаниеРаздела(Параметры.Раздел);

	Заголовок = Раздел.Заголовок;
	ТекстHTML = ТекстМакета(Раздел.Макет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Значок «?» в тексте — ссылка вида bithelp:<ключ>. Ключ определяет, какую страницу справки открыть.
&НаКлиенте
Процедура ПросмотрHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = ДанныеСобытия.Href;
	Префикс = "bithelp:";

	Если Ссылка = Неопределено Или СтрНайти(Ссылка, Префикс) = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Ключ = Сред(Ссылка, СтрНайти(Ссылка, Префикс) + СтрДлина(Префикс));
	Ключ = СтрЗаменить(Ключ, "/", "");

	ОткрытьФорму("ОбщаяФорма.__ИМЯ___Справка", Новый Структура("Раздел", Ключ), ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Страницы справки расширения: ключ раздела -> макет и заголовок окна.
// Тот же ключ передаёт кнопка «?» на формах инструментов и значки «?» в описании расширения.
&НаСервере
Функция ОписаниеРаздела(Ключ)

	Разделы = Новый Соответствие;
	// Каждая страница справки — общий макет __ИМЯ___Справка_<Ключ> (тип «Текстовый документ», HTML).
	// Ключ передают кнопка «?» на форме (Новый Структура("Раздел", "<ключ>")) и ссылки bithelp:<ключ>
	// на странице «Возможности расширения». Пример строки:
	// Разделы.Вставить("settings", Новый Структура("Макет, Заголовок", "__ИМЯ___Справка_Настройки", НСтр("ru = '__СИНОНИМ__: настройки'")));

	Раздел = Разделы.Получить(Ключ);

	Если Раздел = Неопределено Тогда
		Раздел = Новый Структура("Макет, Заголовок", "__ИМЯ___ОписаниеВозможностей", НСтр("ru = 'БИТ: Возможности расширения'"));
	КонецЕсли;

	Возврат Раздел;

КонецФункции

&НаСервере
Функция ТекстМакета(ИмяМакета)

	Макет = ПолучитьОбщийМакет(ИмяМакета);

	Если ТипЗнч(Макет) = Тип("ДвоичныеДанные") Тогда
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Макет, КодировкаТекста.UTF8);
	КонецЕсли;

	Возврат Макет.ПолучитьТекст();

КонецФункции

#КонецОбласти