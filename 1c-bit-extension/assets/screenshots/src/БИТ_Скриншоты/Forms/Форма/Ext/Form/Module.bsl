// Служебная обработка для скриншотов в демобазе: по шагам открывает формы с подготовленными данными
// и после каждого шага пишет файл-флажок step<N>.done в КаталогФлажков — по нему внешний скрипт снимает окно.
// Открывается в уже запущенном сеансе (через Toolkit), поэтому в конце закрывает только свои формы,
// а не завершает сеанс. Сценарий выбирается по имени в КаталогФлажков\scenario.txt.
// Модули конфигурации вызываются через Вычислить: обработка собирается на пустой базе, где их нет.

&НаКлиенте
Перем Данные;
&НаКлиенте
Перем ОткрытыеФормы;
&НаКлиенте
Перем КаталогФлажков;
&НаКлиенте
Перем Сценарий;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КаталогФлажков = КаталогВременныхФайлов() + "bitshots";
	ОткрытыеФормы = Новый Массив;
	Чтение = Новый ЧтениеТекста(КаталогФлажков + "\scenario.txt", КодировкаТекста.UTF8);
	Сценарий = СокрЛП(Чтение.ПрочитатьСтроку());
	Чтение.Закрыть();
	ПодключитьОбработчикОжидания("Шаг1", 2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Флажок(Номер)
	Запись = Новый ЗаписьТекста(КаталогФлажков + "\step" + Номер + ".done");
	Запись.ЗаписатьСтроку("ok");
	Запись.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Шаг1()
	Если Сценарий = "acts" Тогда
		// Акты сверки за 2017 год по контрагентам с оборотами — форма обработки с результатами.
		Данные = ПодготовитьАктыНаСервере();
		Ф = ПолучитьФорму("Обработка.БИТ_СозданиеАктов.Форма");
		Ф.Объект.Организация = Данные.Организация;
		Ф.Объект.ДатаНачала = Данные.ДатаНачала;
		Ф.Объект.ДатаОкончания = Данные.ДатаОкончания;
		Для Каждого Строка Из Данные.Строки Цикл
			ЗаполнитьЗначенияСвойств(Ф.Объект.СписокКонтрагентов.Добавить(), Строка);
		КонецЦикла;
		Для Каждого Док Из Данные.Созданные Цикл
			Ф.Объект.СозданныеДокументы.Добавить().Документ = Док;
		КонецЦикла;
		Ф.Открыть();
		ОткрытыеФормы.Добавить(Ф);
	ИначеЕсли Сценарий = "esfcosts" Тогда
		// Отчёт «Расшифровка затрат по ЭСФ» за 2017 год по ТД Лакомка.
		ТД = РасшифровкаЗатратНаСервере();
		ТД.Показать("БИТ Расшифровка затрат по ЭСФ (01.01.2017 - 31.12.2017, ТД Лакомка)");
	КонецЕсли;
	ПодключитьОбработчикОжидания("Шаг1Готов", 6, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Шаг1Готов()
	Флажок(1);
	ПодключитьОбработчикОжидания("Шаг2", 8, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Шаг2()
	Если Сценарий = "acts" И Данные.Созданные.Количество() > 0 Тогда
		// Один из созданных актов сверки.
		ФА = ПолучитьФорму("Документ.АктСверкиВзаиморасчетов.ФормаОбъекта", Новый Структура("Ключ", Данные.Созданные[0]));
		ФА.Открыть();
		ОткрытыеФормы.Добавить(ФА);
	КонецЕсли;
	ПодключитьОбработчикОжидания("Шаг2Готов", 6, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Шаг2Готов()
	Флажок(2);
	ПодключитьОбработчикОжидания("Конец", 8, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Конец()
	Для Каждого Ф Из ОткрытыеФормы Цикл
		Попытка
			Ф.Закрыть();
		Исключение
		КонецПопытки;
	КонецЦикла;
	Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьАктыНаСервере()
	// Акты создаются заранее (через Toolkit функциями обработки), здесь — только результат для формы:
	// созданный сегодня акт за период — «Создан», найденный ранее — «Уже есть акт № … от …», как в обработке.
	П = Вычислить("БИТ_СозданиеАктовСервер.ПараметрыФормирования()");
	П.Организация = Вычислить("Справочники.Организации.НайтиПоНаименованию(""ТД Лакомка"")");
	П.ДатаНачала = '20170101';
	П.ДатаОкончания = '20171231';
	Результат = Новый Структура("Организация, ДатаНачала, ДатаОкончания, Строки, Созданные",
		П.Организация, П.ДатаНачала, П.ДатаОкончания, Новый Массив, Новый Массив);
	Для Каждого Контрагент Из Вычислить("БИТ_СозданиеАктовСервер.НайтиКонтрагентовПоДвижениям(П, Истина)") Цикл
		Д = Новый Структура("Контрагент, Договор, ДатаНачала, ДатаОкончания", Контрагент, Неопределено, П.ДатаНачала, П.ДатаОкончания);
		Сущ = Вычислить("БИТ_СозданиеАктовСервер.НайтиСуществующийАкт(П, Д)");
		Строка = Новый Структура("Контрагент, ДатаНачала, ДатаОкончания, ДокументАктСверки, Результат",
			Контрагент, П.ДатаНачала, П.ДатаОкончания, Сущ.Ссылка, "");
		Если НачалоДня(Сущ.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Строка.Результат = "Создан";
			Результат.Созданные.Добавить(Сущ.Ссылка);
		Иначе
			Строка.Результат = СтрШаблон("Уже есть акт № %1 от %2", Сущ.Номер, Формат(Сущ.Дата, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Результат.Строки.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция РасшифровкаЗатратНаСервере()
	Отчет = Вычислить("Отчеты.БИТ_РасшифровкаЗатратПоЭСФ.Создать()");
	СКД = Отчет.СхемаКомпоновкиДанных;
	Настр = СКД.НастройкиПоУмолчанию;
	Для Каждого Имя Из СтрРазделить("НачалоПериода,КонецПериода,Период", ",") Цикл
		П = Настр.ПараметрыДанных.Элементы.Найти(Имя);
		Если П <> Неопределено Тогда
			П.Использование = Истина;
			П.Значение = ?(Имя = "НачалоПериода", '20170101', '20171231235959');
		КонецЕсли;
	КонецЦикла;
	Орг = Вычислить("Справочники.Организации.НайтиПоНаименованию(""ТД Лакомка"")");
	Для Каждого Эл Из Настр.Отбор.Элементы Цикл
		Если Строка(Эл.ЛевоеЗначение) = "Организация" Тогда
			Эл.Использование = Истина;
			Эл.ПравоеЗначение = Орг;
		КонецЕсли;
	КонецЦикла;
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = Компоновщик.Выполнить(СКД, Настр);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	ТД = Новый ТабличныйДокумент;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(ТД);
	Вывод.Вывести(Процессор);
	Возврат ТД;
КонецФункции
